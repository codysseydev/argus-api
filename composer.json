{
    "name": "codysseydev/argus-api",
    "description": "JSON HTTP API exposing the codysseydev/argus queue-observability query service.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "queue",
        "observability",
        "monitoring",
        "api",
        "jobs"
    ],
    "homepage": "https://github.com/codysseydev/argus-api",
    "authors": [
        {
            "name": "Davor Minchorov",
            "email": "davorminchorov@gmail.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/codysseydev/argus-api/issues",
        "source": "https://github.com/codysseydev/argus-api"
    },
    "require": {
        "php": "^8.5",
        "codysseydev/argus": "^0.1",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": { "ArgusApi\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "ArgusApi\\Tests\\": "tests/" }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ArgusApi\\ArgusApiServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
